      <data key="d1">"A derogatory term used by Foscarelli to describe an Englishman sharing his compartment, characterized as unsociable and miserable."</data>
      <data key="d2">chunk-9d4c5ec355b91832ff6974cba34014c8</data>
    </node>
    <node id="&quot;AMERICAN GENTLEMAN AT TABLE&quot;">
      <data key="d0">"PERSON"</data>
