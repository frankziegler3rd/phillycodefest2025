      <data key="d2">chunk-cdcbbccf1561d4915ce0f64536c1893b</data>
    </node>
    <node id="&quot;SNOW&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"An unexpected event that disrupts the original plan of the murderer on the train, altering the course of events and complicating the investigation."&lt;SEP&gt;"Weather condition observed by passengers when they looked out of the train window near Belgrade."</data>
      <data key="d2">chunk-cdcbbccf1561d4915ce0f64536c1893b&lt;SEP&gt;chunk-3fd65fe3716ce22231f6ea5162982b25</data>
    </node>
    <node id="&quot;PROHIBITION&quot;">
      <data key="d0">"CATEGORY"</data>
