      <data key="d1">"Grosvenor Square is a location where Sir Henry Tomlinson resided and where Masterman previously served before joining Mr. Ratchett's service."</data>
      <data key="d2">chunk-70a74ad1f7a65a442e84243a05d21bd7</data>
    </node>
