    <node id="&quot;MONSIEUR POIROT (HERCULE POIROT)&quot;">
      <data key="d0">"PERSON"</data>
      <data key="d1">"A detective who observes the interactions among passengers on the train, making mental notes about their behaviors and relationships."</data>
      <data key="d2">chunk-0262591c0f7139618aa8ff97ba9028ed</data>
    </node>
    <node id="&quot;PUNJAB&quot;">
      <data key="d0">"GEO"</data>
